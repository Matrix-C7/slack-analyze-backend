# Reference for the backend's environment variables. Copy to .env for local development (read on start);
# on Render they are set in render.yaml and the dashboard.

PORT=4000

# --- Database: MongoDB Atlas free cluster (M0, 512 MB) ---
# Atlas → Database → Connect → Drivers. Put the database user's password in; keep the query string.
MONGODB_URI=mongodb+srv://slack:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=slack-analyze
# Database name inside the cluster (created on first write)
MONGODB_DB=slack_analyze

# Shared secret the Chrome extension sends as X-API-Key. Leave empty to disable the check.
INGEST_API_KEY=change-me-too
# Set to true when the dashboard is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
# lax for local (frontend and API are both localhost). none when they are different sites,
# e.g. the dashboard on Vercel and this API on Render. none also sets Secure and Partitioned.
COOKIE_SAMESITE=lax
# true behind Render or another reverse proxy
TRUST_PROXY=false

# --- File archive (files and images downloaded from Slack by the extension) ---
# gdrive = a personal Google Drive (default); local = disk (FILE_STORAGE_DIR, default ./data/files), for development
FILE_STORAGE=gdrive
# Temp folder for uploads in flight (and the blobs themselves with FILE_STORAGE=local)
# FILE_STORAGE_DIR=
# Hard cap per file in MB (the extension's own limit can only be lower)
FILE_MAX_MB=100
# OAuth client (type "Desktop app") from Google Cloud Console; then run `npm run gdrive:auth` for the refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Folder in your Drive for the files; created on first upload
GOOGLE_DRIVE_FOLDER_NAME=Slack Analyze files
# Optional: id of a folder this app created earlier (otherwise found by name or created)
# GOOGLE_DRIVE_FOLDER_ID=



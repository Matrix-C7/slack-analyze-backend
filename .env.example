# Reference for the backend's environment variables. Locally, .vscode/tasks.json sets the
# ones needed for development; on Render they are set in render.yaml and the dashboard.

PORT=4000
# Defaults to the project-local cluster started by scripts/dev-db.ps1
DATABASE_URL=postgres://slack:change-me@localhost:5433/slack_analyze
# true for Neon and any other hosted Postgres that requires TLS. Leave false for local.
# A Neon URL already contains sslmode=require; keep that query string.
DATABASE_SSL=false
# Shared secret the Chrome extension sends as X-API-Key. Leave empty to disable the check.
INGEST_API_KEY=change-me-too
# Set to true when the dashboard is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
# lax for local (frontend and API are both localhost). none when they are different sites,
# e.g. the dashboard on Vercel and this API on Render. none also sets Secure and Partitioned.
COOKIE_SAMESITE=lax
# true behind Render or another reverse proxy
TRUST_PROXY=false
# Defaults to migrations/ in this repo
# MIGRATIONS_DIR=

# --- File archive (files and images downloaded from Slack by the extension) ---
# local = disk (FILE_STORAGE_DIR, default ./data/files); s3 = any S3-compatible bucket
FILE_STORAGE=local
# FILE_STORAGE_DIR=
# Hard cap per file in MB (the extension's own limit can only be lower)
FILE_MAX_MB=100
# For FILE_STORAGE=s3, e.g. Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted stores
S3_FORCE_PATH_STYLE=false
S3_PREFIX=slack-files/
